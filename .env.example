# ---------------------------------------------------------------------------
# BHARATVERSE — all optional. The app is fully functional with NONE of these.
# ---------------------------------------------------------------------------

# Bharat AI Guide, Live Mode. Without it the Guide serves grounded, cited,
# offline answers from the curated corpus (MockAIProvider). The key only
# changes phrasing, never facts. Set in Vercel → Settings → Environment
# Variables. Server-only; never exposed to the client.
GEMINI_API_KEY=

# Legacy "Ask the Historian" (Nalanda) Live Mode via Claude. Also optional;
# Demo Mode is grounded and offline without it.
ANTHROPIC_API_KEY=
